# ============================================================
# SECRETS & AUTH TOKENS  ← most important section
# ============================================================
.env
.env.*
*.env

# Spotify OAuth cache files (contain live access tokens)
backend/.cache
backend/.spotifycache
backend/scripts/.cache
.spotifycache
.cache

# ============================================================
# GENERATED DATA & ML ARTIFACTS
# ============================================================

# FAISS index (large binary, rebuild from data)
backend/data/faiss.index
backend/data/*.index
backend/data/*.bin

# Numpy vector files (large, regenerated from CSV/metadata)
backend/data/*.npy
backend/data/song_vectors.npy

# Audio clips downloaded from YouTube
backend/data/songs/*.mp3
backend/data/songs/

# The main CSV and JSON data files (too large / user-specific)
backend/data/my_tracks_with_clap.csv
backend/data/song_metadata.json

# Lyrics and embedding caches (auto-regenerated, contain scraped content)
backend/app/data/lyrics_embeddings.json
backend/app/utils/data/lyrics_cache.json

